# Stratum settings. ./setup.sh copies this to .env (never commit .env).
# After editing: ./setup.sh && docker compose up -d --build

# Port on this machine (devices open https://<this-machine's-LAN-IP>:<port>).
STRATUM_PORT=8930

# App backends to skip, comma-separated (e.g. browser,ssh).
STRATUM_APPS_OFF=

# --- Home app: Home Assistant switches/displays on your walls -------------
# Long-lived token from HA → your profile → Security. Stays in the home
# backend; devices never see it. Empty = the Home backend is left out.
HA_TOKEN=
# HA as seen from inside Docker (host.docker.internal = this machine).
HA_URL=http://host.docker.internal:8123
# Stratum usernames allowed to use Home (comma-separated; "*" = everyone).
HOME_USERS=

# --- SSH app: terminals in AR ---------------------------------------------
# Stratum usernames allowed to open SSH terminals (comma-separated).
# Empty = nobody, "*" = everyone. Sign-in is name-only: trusted LAN only.
SSH_USERS=

# --- Fish tank -------------------------------------------------------------
FISH_HUNGER_HOURS=8

# Written by ./setup.sh (leave as is):
# STRATUM_UID / STRATUM_GID (run containers as you), COMPOSE_FILE.
